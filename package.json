{
  "name": "bloomwood-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test:crm": "node --test tests/crm-metrics.test.mjs tests/crm-page-contracts.test.mjs",
    "test:ui": "node --test tests/crm-ui-contracts.test.mjs crm-preview/client-editor.ui.test.mjs crm-preview/xero.ui.test.mjs crm-preview/products.ui.test.mjs",
    "test:security": "node --test tests/security-regressions.test.mjs crm-preview/worker.test.mjs crm-preview/client-editor.test.mjs crm-preview/work-editor.test.mjs crm-preview/service-editor.test.mjs crm-preview/invoice-editor.test.mjs crm-preview/delivery-editor.test.mjs crm-preview/public-download.test.mjs crm-preview/xero.test.mjs crm-preview/xero-items.test.mjs",
    "cf:check": "npm run build && wrangler deploy --dry-run --config dist/server/wrangler.json",
    "cf:dev": "npm run build && wrangler dev --config dist/server/wrangler.json",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "downloads:upload": "node scripts/upload-download-files.mjs",
    "downloads:issue": "node scripts/issue-download-link.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-aspect-ratio": "^1.1.10",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-menubar": "^1.1.18",
    "@radix-ui/react-navigation-menu": "^1.2.16",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.4.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "jose": "^6.2.17",
    "lucide-react": "^0.563.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@tailwindcss/typography": "^0.5.20",
    "parse5": "^8.1.1",
    "playwright": "^1.58.2",
    "tw-animate-css": "^1.4.0",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "sitemap@<=9.0.0": "9.0.0",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
